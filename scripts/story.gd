## await Story.play(self, "level_01") -- returns at once if there is no card, or it was already shown this session.
static var skip_all := false   # set by the SKIP ALL button: no more cards or cutscenes this session (cleared on the title screen)
## A cutscene that plays right after a card (the level's own card stays split in two: key and key + "_b").
const THEN := {"level_2_1a": "approach"}

static func play(host: Node, key: String) -> void:
	if not CARDS.has(key) or played.has(key) or DisplayServer.get_name() == "headless" and OS.get_environment("TIPS") == "": return
	played[key] = true
	if skip_all:
		if THEN.has(key): played[key + "_b"] = true
		return
	var c := StoryCard.new(CARDS[key][0], CARDS[key][1])
	host.add_child(c)
	await c.done
	if THEN.has(key) and not skip_all:
		var cs: Cutscene = null
		match THEN[key]:
			"approach": cs = ApproachCutscene.new()
		if cs != null:
			host.get_tree().paused = true
			host.add_child(cs)
			await cs.finished
			host.get_tree().paused = false
		await play(host, key + "_b")
static func reset() -> void:
	played.clear()
